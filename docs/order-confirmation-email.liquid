<!--
  THE DOG BOOK — Order Confirmation Email (Lovable design port)
  Design source: docs/post-purchase-design-lovable/src/routes/email.tsx
  Paste into: Shopify Admin → Settings → Notifications → Order confirmation
             (Edit code → replace the body)

  How it works:
    - Upsell variants come from the shop metafield
      `app.email_upsell_snapshot` (json), written by the app's admin page
      (`app/routes/app.post-purchase.jsx`). Edit the offer there, not here.
    - Every tile link + the "Add to my order" CTA is a Shopify cart
      permalink: `/cart/{variantId}:1?attributes[_upsell_source]=order-confirmation&attributes[_upsell_variant]={variantId}`.
      The `_upsell_variant` attribute is what the Discount Function uses to
      scope the % off to only the line the buyer actually clicked — without
      it, any configured upsell variant added from the catalog would also
      pick up the discount.
    - No live countdown (email can't tick); shows the end-time instead.
    - All variants render in a horizontal scroll strip. Works in Apple
      Mail, iOS Mail, and Gmail (web + mobile); Outlook falls back to
      wrapped tiles (no horizontal scroll — ponytail: live with it).
    - The arrows and "N / N" counter are decorative in email — JS is
      stripped so they can't advance selection.
    - "Add to my order" CTA uses the FIRST variant in the list (email
      can't track a user click-to-select).
-->
{%- assign upsell_variants = shop.metafields.app.email_upsell_snapshot | parse_json -%}
{%- comment -%} Track purchased variant/product ids so upsell loops below can skip them. {%- endcomment -%}
{%- assign purchased_ids = ',' -%}
{%- for li in line_items -%}
  {%- assign purchased_ids = purchased_ids | append: li.variant_id | append: ',' | append: li.product_id | append: ',' -%}
{%- endfor -%}
{%- assign remaining_count = 0 -%}
{%- assign first_available_idx = -1 -%}
{%- for v in upsell_variants -%}
  {%- assign v_check = ',' | append: v.variantId | append: ',' -%}
  {%- assign p_check = ',' | append: v.productId | append: ',' -%}
  {%- unless purchased_ids contains v_check or purchased_ids contains p_check -%}
    {%- assign remaining_count = remaining_count | plus: 1 -%}
    {%- if first_available_idx == -1 -%}
      {%- assign first_available_idx = forloop.index0 -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign offer_cfg = shop.metafields.app.post_purchase_offer | parse_json -%}
{%- assign percent = offer_cfg.discountPercent | default: 20 -%}
{%- assign percent_remainder = 100 | minus: percent -%}
{%- assign offer_deadline_ts = 'now' | date: '%s' | plus: 86400 -%}
{%- assign offer_deadline = offer_deadline_ts | date: '%B %-d, %-l:%M %p' -%}
{%- assign offer_deadline_iso = offer_deadline_ts | date: '%Y-%m-%dT%H:%M:%SZ' -%}
{%- comment -%}
  COUNTDOWN TIMER PNG.
  Default: CleverTimer hosted URL (fixed deadline, shared across recipients).
  Alt:     our Vercel app at /api/timer?o=<order.id> (per-order 24h from first open).
           Swap `timer_url` if you want per-recipient countdown instead.
{%- endcomment -%}
{%- comment -%} Vercel /api/timer.gif: 60-frame animated GIF, 60s/frame, plays once over 1 hour. {%- endcomment -%}
{%- assign send_ts = 'now' | date: '%s' -%}
{%- assign timer_url = 'https://stg-dogbook-app.vercel.app/api/timer.gif?t=' | append: send_ts -%}

<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>{{ shop.name }} — Order Confirmed</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
  <style>
    body, table, td { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { border: 0; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; display: block; }
    body { margin: 0; padding: 0; width: 100% !important; background-color: #F6F4EF; }
    a { text-decoration: none; }
    @media only screen and (max-width:600px) {
      .container { width: 100% !important; }
      .stack { display: block !important; width: 100% !important; }
      .px-mobile { padding-left: 20px !important; padding-right: 20px !important; }
      .py-mobile { padding-top: 20px !important; padding-bottom: 20px !important; }
      .upsell-cta { width: 100% !important; display: block !important; }
      .upsell-action { padding-top: 12px !important; }
    }
  </style>
</head>

<body style="margin:0; padding:0; background-color:#F6F4EF;">

  <div style="display:none; max-height:0; overflow:hidden; font-size:1px; line-height:1px; color:#F6F4EF; opacity:0;">
    Order {{ order_name }} confirmed — your Dog Book is on its way.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F6F4EF;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" class="container" width="576" cellpadding="0" cellspacing="0"
               style="width:576px; max-width:576px; background-color:#FFFFFF; table-layout:fixed;">

          <!-- header: THE DOG BOOK wordmark -->
          <tr>
            <td align="center" style="padding:16px 40px; border-bottom:1px solid #DED9CF;">
              <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; letter-spacing:3.5px; color:#1E1C18; font-weight:700; text-transform:uppercase;">
                The Dog Book
              </div>
            </td>
          </tr>

          <!-- greeting + CONFIRMED pill -->
          <tr>
            <td class="px-mobile py-mobile" style="padding:24px 40px 0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td valign="top" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                    <div style="font-size:18px; font-weight:700; color:#1E1C18; line-height:1.3;">
                      Thanks, {{ customer.first_name | default: billing_address.first_name }} — your book is on its way.
                    </div>
                    <div style="font-size:12px; color:#7B766D; margin-top:6px;">
                      Order {{ order_name }} &middot; {{ order.created_at | date: "%B %-d, %Y" }}
                    </div>
                  </td>
                  <td valign="top" align="right" style="padding-left:12px; white-space:nowrap;">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="background-color:#F0ECE2; padding:6px 10px;">
                          <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:1.2px; color:#2F6E3E; font-weight:700; text-transform:uppercase;">
                            &#10003;&nbsp; Confirmed
                          </span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- line items + totals -->
          <tr>
            <td class="px-mobile" style="padding:16px 40px 0 40px;">
              {% for line in line_items %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                     style="background-color:#F6F4EF; margin-bottom:8px;">
                <tr>
                  <td style="padding:12px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="44" valign="top" style="width:44px;">
                          <img src="{{ line.image | image_url: width: 112 }}" width="44" height="56"
                               alt="{{ line.title | escape }} cover"
                               style="width:44px; height:56px; object-fit:cover; background-color:#4D543A;">
                        </td>
                        <td valign="middle" style="padding-left:12px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                          <div style="font-size:14px; font-weight:700; color:#1E1C18;">
                            {{ line.title }} &middot; Qty {{ line.quantity }}
                          </div>
                          <div style="font-size:12px; color:#7B766D; margin-top:2px;">Your Dog Book</div>
                        </td>
                        <td valign="middle" align="right"
                            style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; font-weight:700; color:#1E1C18; white-space:nowrap;">
                          {{ line.final_price | money }}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
              {% endfor %}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                     style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#1E1C18;">
                <tr><td style="padding:6px 4px;">Subtotal</td>
                    <td align="right" style="padding:6px 4px;">{{ subtotal_price | money }}</td></tr>
                <tr><td style="padding:6px 4px;">Shipping</td>
                    <td align="right" style="padding:6px 4px;">{{ shipping_price | money }}</td></tr>
                {% if tax_price and tax_price > 0 %}
                <tr><td style="padding:6px 4px;">Tax</td>
                    <td align="right" style="padding:6px 4px;">{{ tax_price | money }}</td></tr>
                {% endif %}
                {% if total_discounts and total_discounts > 0 %}
                <tr><td style="padding:6px 4px; color:#2F6E3E;">Discount</td>
                    <td align="right" style="padding:6px 4px; color:#2F6E3E;">&minus;{{ total_discounts | money }}</td></tr>
                {% endif %}
                <tr><td colspan="2" style="padding:8px 0 0 0;"><div style="border-top:1px solid #DED9CF;"></div></td></tr>
                <tr><td style="padding:8px 4px 0 4px; font-size:16px; font-weight:700;">Total</td>
                    <td align="right" style="padding:8px 4px 0 4px; font-size:16px; font-weight:700;">{{ total_price | money }}</td></tr>
              </table>

              <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#7B766D; padding:12px 4px 0 4px; line-height:1.5;">
                Ships to {{ shipping_address.name }}, {{ shipping_address.city }} &middot; arriving in 8&ndash;12 weeks, tracked.
              </div>
            </td>
          </tr>

          <!-- UPSELL PANEL -->
          {%- if remaining_count > 0 -%}

          <tr>
            <td class="px-mobile" style="padding:20px 40px 0 40px;">
              <table role="presentation" role="region" aria-label="Add a book offer" width="100%"
                     cellpadding="0" cellspacing="0" style="width:100%; table-layout:fixed; border:1px solid #2F6E3E; background-color:#F2F7F3;">
                <tr>
                  <td style="padding:20px;">

                    <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:24px; font-weight:700; color:#1E1C18; line-height:1.2;">
                      {{ percent }}% off any book you add
                    </div>

                    <!-- inline countdown: "Order in the next HH:MM:SS to get N% off." -->
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;">
                      <tr>
                        <td style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#7B766D; line-height:1; white-space:nowrap; padding-right:6px; vertical-align:middle;">Order in the next</td>
                        <td style="padding:6px 0 0 0; vertical-align:middle;"><img src="https://inboxtimer.app/t/gjtin80.gif?rid={{ email }}" alt="time left" width="93" height="30" style="display:block; width:93px; height:30px; border:0; outline:none; text-decoration:none;"></td>
                        <td style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#7B766D; line-height:1; white-space:nowrap; padding-left:6px; vertical-align:middle;">to get {{ percent }}% off.</td>
                      </tr>
                    </table>

                    <!-- badges -->
                    <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:12px;">
                      <tr>
                        <td style="background-color:#2F6E3E; padding:4px 10px;">
                          <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:1px; color:#FFFFFF; font-weight:700; text-transform:uppercase;">
                            &minus;{{ percent }}%
                          </span>
                        </td>
                        <td style="width:8px;">&nbsp;</td>
                        <td style="border:1px solid #2F6E3E; padding:3px 10px;">
                          <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:1px; color:#2F6E3E; font-weight:700; text-transform:uppercase;">
                            $0 Extra Shipping
                          </span>
                        </td>
                      </tr>
                    </table>

                    <!-- breed scroll strip: all variants as inline-block tiles,
                         each with price + Add button. Horizontal scroll on
                         supporting clients; wraps in Outlook. -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%; table-layout:fixed; margin-top:16px;">
                      <tr><td style="padding:0;">
                    <div style="width:100%; max-width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch; white-space:nowrap; font-size:0;">
                      {%- assign tile_counter = 0 -%}
                      {%- for variant in upsell_variants -%}
                      {%- assign v_check = ',' | append: variant.variantId | append: ',' -%}
                      {%- assign p_check = ',' | append: variant.productId | append: ',' -%}
                      {%- if purchased_ids contains v_check or purchased_ids contains p_check -%}{%- continue -%}{%- endif -%}
                      {%- assign tile_counter = tile_counter | plus: 1 -%}
                      {%- assign v_cart_url = shop.url | append: '/cart/' | append: variant.variantId | append: ':1?attributes[_upsell_source]=order-confirmation&attributes[_upsell_variant]=' | append: variant.variantId -%}
                      {%- assign v_original = variant.price | times: 100.0 -%}
                      {%- assign v_discounted = variant.price | times: 100.0 | times: percent_remainder | divided_by: 100 -%}
                      {%- if tile_counter == 1 -%}
                        {%- assign tile_border = '#2F6E3E' -%}
                        {%- assign tile_bg = '#EAF2EC' -%}
                      {%- else -%}
                        {%- assign tile_border = '#DED9CF' -%}
                        {%- assign tile_bg = '#FFFFFF' -%}
                      {%- endif -%}
                      <div style="display:inline-block; vertical-align:top; width:140px; margin-right:8px; padding:8px; box-sizing:border-box; background-color:{{ tile_bg }}; border:1px solid {{ tile_border }}; white-space:normal;">
                        <div style="background-color:#F6F4EF; height:100px; line-height:100px; text-align:center;">
                          <img src="{{ variant.imageUrl }}" width="68" height="90"
                               alt="{{ variant.productTitle | escape }} cover"
                               style="width:68px; height:90px; object-fit:cover; display:inline-block; vertical-align:middle;">
                        </div>
                        <div style="padding:8px 2px 4px 2px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; font-weight:700; color:#1E1C18; line-height:1.3;">
                          {{ variant.productTitle }}
                        </div>
                        <div style="padding:0 2px 8px 2px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; white-space:nowrap;">
                          <s style="font-size:11px; color:#7B766D; text-decoration:line-through;">{{ v_original | money }}</s>
                          <strong style="font-size:13px; font-weight:700; color:#1E1C18; margin-left:4px;">{{ v_discounted | money }}</strong>
                        </div>
                        <a href="{{ v_cart_url }}"
                           style="display:block; background-color:#1E1C18; padding:8px 10px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; font-weight:700; color:#FFFFFF; text-align:center; text-decoration:none;">
                          Add
                        </a>
                      </div>
                      {%- endfor -%}
                    </div>
                      </td></tr>
                    </table>

                    <!-- counter row -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px;">
                      <tr>
                        <td valign="middle" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#7B766D;">
                          All breeds available &mdash; scroll to see more &rarr;
                        </td>
                        <td valign="middle" align="right" style="white-space:nowrap; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#7B766D; font-weight:600;">
                          1 / {{ remaining_count }}
                        </td>
                      </tr>
                    </table>

                    <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#7B766D; text-align:center; margin-top:12px;">
                      &#128274;&nbsp; One click &middot; no card details
                    </div>

                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {%- endif -%}

          <!-- track order link -->
          <tr>
            <td align="center" class="px-mobile" style="padding:20px 40px 8px 40px;">
              <a href="{{ order_status_url }}"
                 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13px; font-weight:600; color:#1E1C18; text-decoration:underline; letter-spacing:0.5px;">
                Track your order &rarr;
              </a>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td align="center" class="px-mobile"
                style="padding:24px 40px 32px 40px; border-top:1px solid #DED9CF; margin-top:24px;">
              <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13px; color:#7B766D; margin:16px 0 12px 0;">
                Questions? <a href="mailto:{{ shop.email }}" style="color:#1E1C18; font-weight:700;">Reply to this email</a>
              </div>
              <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#7B766D;">
                <a href="{{ shop.url }}/pages/faq" style="color:#7B766D;">FAQ</a>
                &nbsp;&middot;&nbsp;
                <a href="{{ shop.url }}/pages/return-policy" style="color:#7B766D;">Returns</a>
                &nbsp;&middot;&nbsp;
                <a href="{{ shop.url }}/pages/contact" style="color:#7B766D;">Contact</a>
              </div>
              <div style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; color:#A8A8A8; margin-top:16px;">
                &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
              </div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
