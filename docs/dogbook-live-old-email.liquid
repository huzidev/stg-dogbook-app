<!--
  THE DOG BOOK — Order Confirmation Email (Modern)
  Paste into: Shopify Admin → Settings → Notifications → Order confirmation
-->
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{ shop.name }} — Order Confirmed</title>
    <!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<![endif]-->
    <style>
        body,
        table,
        td {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            border: 0;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            background-color: #F3F2EE;
        }

        a {
            text-decoration: none;
        }

        @media only screen and (max-width:600px) {
            .container {
                width: 100% !important;
            }

            .stack {
                display: block !important;
                width: 100% !important;
            }

            .plate-img {
                width: 100% !important;
                height: auto !important;
            }

            .px-mobile {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }

            .h1 {
                font-size: 28px !important;
            }

            .stack-text {
                padding-left: 0 !important;
                padding-top: 16px !important;
            }
        }
    </style>
</head>

<body style="margin:0; padding:0; background-color:#F3F2EE;">

    <div style="display:none; max-height:0; overflow:hidden; font-size:1px; line-height:1px; color:#F3F2EE; opacity:0;">
        Order {{ order_name }} confirmed — your Dog Book is on its way.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F3F2EE;">
        <tr>
            <td align="center" style="padding:32px 16px;">

                <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0"
                    style="width:600px; max-width:600px; background-color:#FFFFFF;">

                    <!-- top nav bar -->
                    <tr>
                        <td align="center" style="padding:28px 40px 24px 40px; border-bottom:1px solid #ECEBE6;">
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:15px; letter-spacing:3px; color:#111111; font-weight:700; text-transform:uppercase;">
                                The Dog Book
                            </div>
                        </td>
                    </tr>

                    <!-- status chip + headline -->
                    <tr>
                        <td align="center" class="px-mobile" style="padding:52px 40px 40px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 20px auto;">
                                <tr>
                                    <td style="background-color:#EAF2EC; padding:7px 16px; border-radius:100px;">
                                        <span
                                            style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:1.5px; color:#1F7A45; font-weight:700; text-transform:uppercase;">
                                            &#10003; Order Confirmed
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <div class="h1"
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:34px; line-height:1.15; color:#111111; font-weight:700; letter-spacing:-0.5px;">
                                Thanks, {{ customer.first_name | default: billing_address.first_name }}.<br>Your Dog
                                Book is on its way.
                            </div>
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#6B6B6B; margin-top:14px;">
                                Order {{ order_name }} &nbsp;&middot;&nbsp; {{ order.created_at | date: "%B %-d, %Y" }}
                            </div>
                        </td>
                    </tr>

                    <!-- product card(s) -->
                    {% for line in line_items %}
                    <tr>
                        <td class="px-mobile" style="padding:0 40px 24px 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                style="background-color:#F7F6F2; border-radius:16px;">
                                <tr>
                                    <td style="padding:24px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td class="stack" width="96" valign="top" style="width:96px;">
                                                    <img class="plate-img"
                                                        src="{{ line.image | image_url: width: 200 }}" width="96"
                                                        alt="{{ line.title }}"
                                                        style="width:96px; height:96px; object-fit:cover; display:block; border-radius:10px; background-color:#EDECE7;">
                                                </td>
                                                <td class="stack stack-text" valign="top" style="padding-left:20px;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0"
                                                        style="margin-bottom:8px;">
                                                        <tr>
                                                            <td
                                                                style="background-color:#111111; padding:4px 10px; border-radius:100px;">
                                                                <span
                                                                    style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:9px; letter-spacing:1px; color:#FFFFFF; font-weight:700; text-transform:uppercase;">
                                                                    Your Dog Book
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:19px; font-weight:700; color:#111111; margin-bottom:4px;">
                                                        {{ line.title }}
                                                    </div>
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13px; color:#6B6B6B; margin-bottom:10px;">
                                                        Qty {{ line.quantity }}
                                                    </div>
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:17px; font-weight:700; color:#111111;">
                                                        {{ line.final_price | money }}
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {% endfor %}

                    <!-- order summary -->
                    <tr>
                        <td class="px-mobile" style="padding:16px 40px 0 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#111111;">
                                <tr>
                                    <td style="padding:8px 0; color:#6B6B6B;">Subtotal</td>
                                    <td align="right" style="padding:8px 0;">{{ subtotal_price | money }}</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0; color:#6B6B6B;">Shipping</td>
                                    <td align="right" style="padding:8px 0;">{{ shipping_price | money }}</td>
                                </tr>
                                {% if tax_price and tax_price > 0 %}
                                <tr>
                                    <td style="padding:8px 0; color:#6B6B6B;">Tax</td>
                                    <td align="right" style="padding:8px 0;">{{ tax_price | money }}</td>
                                </tr>
                                {% endif %}
                                {% if total_discounts and total_discounts > 0 %}
                                <tr>
                                    <td style="padding:8px 0; color:#1F7A45;">Discount</td>
                                    <td align="right" style="padding:8px 0; color:#1F7A45;">&minus;{{ total_discounts |
                                        money }}</td>
                                </tr>
                                {% endif %}
                                <tr>
                                    <td colspan="2" style="padding:14px 0 0 0;">
                                        <div style="border-top:1px solid #ECEBE6;"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:14px 0 0 0; font-size:16px; font-weight:700;">Total</td>
                                    <td align="right" style="padding:14px 0 0 0; font-size:16px; font-weight:700;">{{
                                        total_price | money }}</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- shipping info -->
                    <tr>
                        <td class="px-mobile" style="padding:36px 40px 0 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                style="background-color:#F7F6F2; border-radius:16px;">
                                <tr>
                                    <td style="padding:24px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td class="stack" width="50%" valign="top" style="width:50%;">
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:1px; color:#6B6B6B; text-transform:uppercase; font-weight:700; margin-bottom:8px;">
                                                        Shipping to
                                                    </div>
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#111111; line-height:1.6;">
                                                        {{ shipping_address.name }}<br>
                                                        {{ shipping_address.address1 }}<br>
                                                        {% if shipping_address.address2 != blank %}{{
                                                        shipping_address.address2 }}<br>{% endif %}
                                                        {{ shipping_address.city }}, {{ shipping_address.province_code
                                                        }} {{ shipping_address.zip }}
                                                    </div>
                                                </td>
                                                <td class="stack" width="50%" valign="top" style="width:50%;">
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:1px; color:#6B6B6B; text-transform:uppercase; font-weight:700; margin-bottom:8px;">
                                                        Arriving
                                                    </div>
                                                    <div
                                                        style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; color:#111111; line-height:1.6;">
                                                        8-12 weeks<br>Tracked shipping
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td align="center" class="px-mobile" style="padding:36px 40px 8px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center" style="background-color:#111111; border-radius:100px;">
                                        <a href="{{ order_status_url }}"
                                            style="display:block; padding:16px 0; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:14px; font-weight:700; color:#FFFFFF;">
                                            Track your order
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- social proof -->
                    <tr>
                        <td class="px-mobile" style="padding:44px 40px 8px 40px;">
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:1px; color:#6B6B6B; text-transform:uppercase; font-weight:700; text-align:center; margin-bottom:16px;">
                                ★★★★★ &nbsp;What collectors say
                            </div>
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:15px; color:#111111; line-height:1.6; text-align:center; max-width:420px; margin:0 auto;">
                                "The cloth binding and paper stock are extraordinary. It sits on the table like a piece
                                of art, not a book."
                            </div>
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#6B6B6B; text-align:center; margin-top:10px;">
                                James W. — Chicago, IL
                            </div>
                        </td>
                    </tr>

                    <!-- footer -->
                    <tr>
                        <td align="center" class="px-mobile"
                            style="padding:40px 40px 40px 40px; border-top:1px solid #ECEBE6; margin-top:40px;">
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:13px; color:#6B6B6B; margin:28px 0 16px 0;">
                                Questions? <a href="mailto:{{ shop.email }}"
                                    style="color:#111111; font-weight:700;">Reply to this email</a>
                            </div>
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:12px; color:#6B6B6B;">
                                <a href="{{ shop.url }}/pages/faq" style="color:#6B6B6B;">FAQ</a>
                                &nbsp;&nbsp;&middot;&nbsp;&nbsp;
                                <a href="{{ shop.url }}/pages/return-policy" style="color:#6B6B6B;">Returns</a>
                                &nbsp;&nbsp;&middot;&nbsp;&nbsp;
                                <a href="{{ shop.url }}/pages/contact" style="color:#6B6B6B;">Contact</a>
                            </div>
                            <div
                                style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; font-size:11px; color:#A8A8A8; margin-top:20px;">
                                &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
                            </div>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>